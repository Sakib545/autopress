# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autoblog?schema=public"

# ---------------------------------------------------------------------------
# Auth (required). Generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Seed admin account (used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# ---------------------------------------------------------------------------
# Redis / queues (required for the worker; web falls back to inline mode)
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# AI provider. "mock" runs the entire pipeline offline with no API key.
# Options: mock | openai | anthropic | google
# ---------------------------------------------------------------------------
AI_PROVIDER="mock"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""

# Optional per-task model overrides (admin settings take precedence over these)
AI_MODEL_WRITING=""
AI_MODEL_REVIEW=""
AI_MODEL_CHEAP=""
AI_MODEL_STANDARD=""
# Point OPENAI_API_KEY at any OpenAI-compatible router instead of OpenAI
# itself. Leave blank for OpenAI. Example: https://router.example.com/v1
OPENAI_BASE_URL=""

# ---------------------------------------------------------------------------
# Research provider. "mock" returns deterministic fixtures.
# Options: mock | tavily | serpapi
# ---------------------------------------------------------------------------
RESEARCH_PROVIDER="mock"
TAVILY_API_KEY=""
SERPAPI_API_KEY=""

# ---------------------------------------------------------------------------
# Images. "fallback" generates a deterministic SVG cover, no API key needed.
# Options: fallback | stock | ai
# ---------------------------------------------------------------------------
IMAGE_PROVIDER="fallback"
IMAGE_API_KEY=""
UNSPLASH_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Signal Review"

# ---------------------------------------------------------------------------
# Automation / ops
# ---------------------------------------------------------------------------
CRON_SECRET=""
WORKER_CONCURRENCY="2"
MONTHLY_AI_BUDGET_USD="50"

# Set to "false" to hide seeded demo articles from the public site
SHOW_SAMPLE_CONTENT="true"

# ---------------------------------------------------------------------------
# MoneyPrinterTurbo — external short-form video service.
# Runs as its OWN service (docker compose up in the MoneyPrinterTurbo repo).
# It is never bundled into this app; only its HTTP API is used.
# Article publishing never waits on it — if it is offline, articles still
# publish and video jobs retry independently.
# ---------------------------------------------------------------------------
# Master switch. With this false, nothing in the video pipeline runs: no
# database writes, no HTTP calls, no log noise. The blog is unaffected.
MPT_ENABLED="false"
# Server-side only. Never sent to the browser, never taken from user input.
MPT_API_URL="http://127.0.0.1:8080"

# Queue a video automatically when an article becomes PUBLISHED.
# Manual "Generate video" in the admin works even when this is false —
# it only requires MPT_ENABLED=true.
MPT_AUTO_VIDEO="true"

# --- Output ----------------------------------------------------------------
MPT_VIDEO_LANGUAGE="en"
MPT_VIDEO_ASPECT="9:16"
# Target narration length in seconds. Drives the script word budget
# (~150 words per minute), so 45s asks the model for roughly 85-130 words.
MPT_VIDEO_DURATION="45"
MPT_VIDEO_QUALITY="1080p"
MPT_VIDEO_SOURCE="pexels"
MPT_VIDEO_COUNT="1"

# --- Polling ---------------------------------------------------------------
# How often the worker asks MoneyPrinterTurbo for task progress, and how long
# it waits before giving up and marking the video FAILED (the task id is kept).
MPT_POLL_INTERVAL_MS="10000"
MPT_MAX_POLL_MINUTES="30"

# --- Retries ---------------------------------------------------------------
# Automatic retry after a *retryable* failure (service unreachable, 5xx).
# A rejected request is never retried automatically; use Retry in the admin.
MPT_AUTO_RETRY="true"
MPT_MAX_RETRIES="3"

# --- Serving finished files ------------------------------------------------
# MoneyPrinterTurbo reports renders as paths on its own filesystem. AutoPress
# converts those into {base}/api/v1/download/{task_id}/{file}. Set this when the
# files are reachable at a different origin than MPT_API_URL (CDN, reverse
# proxy, public host). Leave empty to use MPT_API_URL.
MPT_PUBLIC_BASE_URL=""
# Deprecated alias for MPT_PUBLIC_BASE_URL, still honoured.
MPT_PUBLIC_URL=""

# Optional: bearer token, if you put MPT behind an auth proxy.
# MoneyPrinterTurbo itself has no authentication — do not expose it publicly.
MPT_API_KEY=""

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
ANALYTICS_ID=""
NEXT_PUBLIC_GA_ID=""
