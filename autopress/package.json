{
  "name": "autopress",
  "version": "1.0.0",
  "private": true,
  "description": "Automated AI content publishing platform",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "worker": "tsx worker/index.ts",
    "worker:dev": "tsx watch worker/index.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev --name init",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "bullmq": "5.28.2",
    "clsx": "2.1.1",
    "dotenv": "16.4.5",
    "ioredis": "5.4.1",
    "marked": "14.1.3",
    "next": "^15.1.11",
    "next-auth": "5.0.0-beta.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sanitize-html": "2.13.1",
    "tailwind-merge": "2.5.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.15",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.6",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@types/sanitize-html": "2.13.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.1.6",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.15",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20.11"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.23.1": true,
    "sharp@0.33.5": true,
    "msgpackr-extract@3.0.4": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  }
}
