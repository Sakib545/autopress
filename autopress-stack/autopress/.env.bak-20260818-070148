# ---------------------------------------------------------------------------
# MoneyPrinterTurbo — external short-form video service.
# Runs as its OWN service (docker compose up in the MoneyPrinterTurbo repo).
# It is never bundled into this app; only its HTTP API is used.
# Article publishing never waits on it — if it is offline, articles still
# publish and video jobs retry independently.
# ---------------------------------------------------------------------------
MPT_ENABLED="false"
MPT_API_URL="http://127.0.0.1:8080"
# Optional: public base URL if MPT returns relative paths and is served
# from a different host than its API (e.g. behind a CDN).
MPT_PUBLIC_URL=""
# Optional: bearer token, if you put MPT behind an auth proxy.
MPT_API_KEY=""
MPT_AUTO_VIDEO="true"
MPT_VIDEO_ASPECT="9:16"
MPT_VIDEO_SOURCE="pexels"
MPT_VIDEO_LANGUAGE="en"
MPT_VIDEO_COUNT="1"

